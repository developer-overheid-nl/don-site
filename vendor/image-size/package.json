{
  "name": "image-size",
  "version": "2.0.3",
  "private": true,
  "description": "Security-compatible image-size API for Docusaurus",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./fromFile": {
      "types": "./fromFile.d.ts",
      "require": "./fromFile.js",
      "default": "./fromFile.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "probe-image-size": "7.4.0"
  }
}
